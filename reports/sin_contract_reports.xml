<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Reporte de Contrato -->
    <record id="report_sin_contract" model="ir.actions.report">
        <field name="name">Contrato</field>
        <field name="model">sin.contract</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_bo_contracts.report_sin_contract_document</field>
        <field name="report_file">l10n_bo_contracts.report_sin_contract_document</field>
        <field name="binding_model_id" ref="model_sin_contract"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">('Contrato_%s' % (object.name or 'sin_numero'))</field>
    </record>

    <template id="report_sin_contract_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="l10n_bo_contracts.report_sin_contract_inner"/>
            </t>
        </t>
    </template>

    <template id="report_sin_contract_inner">
        <div class="page" style="font-size:12px; padding:20px;">
            <style>
                table { border-collapse: collapse !important; width: 100%; }
                td, th { border: none !important; padding: 4px 6px; vertical-align: top; }
                .sin-signature-block { margin-top: 48px; }
                .sin-signature-line { border-bottom: 1px solid #000; width: 40%; height: 12px; }
                .sin-signature-img { max-height: 90px; max-width: 220px; }
            </style>

            <!-- Encabezado: datos de la empresa -->
            <table style="margin-bottom: 12px;">
                <tr>
                    <td style="width: 30%; text-align: left;">
                        <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)"
                             style="max-height: 110px; max-width: 190px;" alt="Logo"/>
                    </td>
                    <td style="width: 70%; text-align: center; vertical-align: middle;">
                        <div style="font-size: 22px; font-weight: bold; letter-spacing: 1px;">
                            <t t-esc="o.document_title or 'CONTRATO'"/>
                        </div>
                        <div style="font-size: 14px; font-weight: bold; margin-top: 4px;">
                            <t t-esc="o.company_id.name or ''"/>
                        </div>
                        <div style="font-size: 11px; margin-top: 2px;">
                            NIT: <t t-esc="o.company_id.vat or ''"/>
                            <t t-if="o.company_id.street"> | <t t-esc="o.company_id.street"/></t>
                            <t t-if="o.company_id.city"> | <t t-esc="o.company_id.city"/></t>
                        </div>
                        <div style="font-size: 11px;">
                            Nº <t t-esc="o.name or ''"/> | Fecha: <t t-esc="o.date or ''"/>
                        </div>
                    </td>
                </tr>
            </table>

            <!-- Datos del cliente -->
            <table style="border: 1px solid #000; margin-bottom: 12px; font-size: 12px;">
                <tr>
                    <td style="width: 16%; font-weight: bold;">Señor(es):</td>
                    <td style="width: 44%;"><t t-esc="o.partner_id.name or ''"/></td>
                    <td style="width: 16%; font-weight: bold;">Documento:</td>
                    <td><t t-esc="o.partner_document or ''"/></td>
                </tr>
                <tr>
                    <td style="font-weight: bold;">Dirección:</td>
                    <td><t t-esc="o.partner_address or ''"/></td>
                    <td style="font-weight: bold;">Teléfono:</td>
                    <td><t t-esc="o.partner_id.phone or ''"/></td>
                </tr>
            </table>

            <!-- Cuerpo del documento -->
            <div t-if="o.intro_html" class="sin-intro">
                <t t-out="o.intro_html"/>
            </div>

            <div t-if="o.body_html" class="sin-body" style="margin-top: 12px;">
                <t t-out="o.body_html"/>
            </div>

            <div t-if="o.closing_html" class="sin-closing" style="margin-top: 16px;">
                <t t-out="o.closing_html"/>
            </div>

            <!-- Firmas -->
            <table class="sin-signature-block">
                <tr>
                    <td style="width: 50%; text-align: center;" t-if="o.sign_client">
                        <div>
                            <t t-if="o.client_signature">
                                <img class="sin-signature-img" t-att-src="'data:image/png;base64,' + o.client_signature"/>
                            </t>
                            <t t-else="">
                                <div class="sin-signature-line"></div>
                            </t>
                        </div>
                        <div style="margin-top: 4px; font-weight: bold;">
                            <t t-esc="o.client_signature_name or o.partner_id.name or ''"/>
                        </div>
                        <div style="font-size: 11px; color: #555;">Firma del Cliente</div>
                        <div t-if="o.client_signature_date" style="font-size: 10px; color: #888;">
                            <t t-esc="o.client_signature_date.strftime('%d/%m/%Y %H:%M')"/>
                        </div>
                    </td>
                    <td style="width: 50%; text-align: center;" t-if="o.sign_company">
                        <div>
                            <t t-if="o.company_signature">
                                <img class="sin-signature-img" t-att-src="'data:image/png;base64,' + o.company_signature"/>
                            </t>
                            <t t-else="">
                                <div class="sin-signature-line"></div>
                            </t>
                        </div>
                        <div style="margin-top: 4px; font-weight: bold;">
                            <t t-esc="o.company_signature_name or o.company_id.sin_contract_representative or o.company_id.name or ''"/>
                        </div>
                        <div style="font-size: 11px; color: #555;">La Empresa</div>
                        <div t-if="o.company_signature_date" style="font-size: 10px; color: #888;">
                            <t t-esc="o.company_signature_date.strftime('%d/%m/%Y %H:%M')"/>
                        </div>
                    </td>
                </tr>
            </table>
        </div>
    </template>

    <!-- Reporte de Certificado de Garantía -->
    <record id="report_sin_warranty" model="ir.actions.report">
        <field name="name">Certificado de Garantía</field>
        <field name="model">sin.warranty</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_bo_contracts.report_sin_warranty_document</field>
        <field name="report_file">l10n_bo_contracts.report_sin_warranty_document</field>
        <field name="binding_model_id" ref="model_sin_warranty"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">('Certificado_Garantia_%s' % (object.name or 'sin_numero'))</field>
    </record>

    <template id="report_sin_warranty_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="l10n_bo_contracts.report_sin_warranty_inner"/>
            </t>
        </t>
    </template>

    <template id="report_sin_warranty_inner">
        <div class="page" style="font-size: 12px; padding: 20px;">
            <style>
                table { border-collapse: collapse !important; width: 100%; }
                td, th { border: none !important; padding: 4px 6px; vertical-align: top; }
                .sin-warr-table th, .sin-warr-table td { border: 1px solid #000 !important; }
                .sin-signature-line { border-bottom: 1px solid #000; width: 40%; height: 12px; }
                .sin-signature-img { max-height: 90px; max-width: 220px; }
            </style>

            <table style="margin-bottom: 12px;">
                <tr>
                    <td style="width: 30%; text-align: left;">
                        <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)"
                             style="max-height: 110px; max-width: 190px;" alt="Logo"/>
                    </td>
                    <td style="width: 70%; text-align: center; vertical-align: middle;">
                        <div style="font-size: 22px; font-weight: bold; letter-spacing: 1px;">
                            <t t-esc="o.document_title or 'CERTIFICADO DE GARANTÍA'"/>
                        </div>
                        <div style="font-size: 14px; font-weight: bold; margin-top: 4px;">
                            <t t-esc="o.company_id.name or ''"/>
                        </div>
                        <div style="font-size: 11px;">NIT: <t t-esc="o.company_id.vat or ''"/></div>
                        <div style="font-size: 11px;">
                            Nº <t t-esc="o.name or ''"/> | Fecha: <t t-esc="o.date or ''"/>
                            <t t-if="o.date_expiry"> | Vence: <t t-esc="o.date_expiry"/></t>
                        </div>
                    </td>
                </tr>
            </table>

            <table style="border: 1px solid #000; margin-bottom: 12px;">
                <tr>
                    <td style="width: 16%; font-weight: bold;">Cliente:</td>
                    <td style="width: 44%;"><t t-esc="o.partner_id.name or ''"/></td>
                    <td style="width: 16%; font-weight: bold;">Documento:</td>
                    <td><t t-esc="o.partner_document or ''"/></td>
                </tr>
            </table>

            <table class="sin-warr-table" style="margin-bottom: 12px;">
                <thead>
                    <tr>
                        <th style="width: 6%; text-align: center;">Nº</th>
                        <th style="width: 50%; text-align: left;">Producto</th>
                        <th style="width: 12%; text-align: center;">Cant.</th>
                        <th style="width: 32%; text-align: left;">Nº de serie</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="o.line_ids" t-as="line">
                        <tr>
                            <td style="text-align: center;"><t t-esc="line_index + 1"/></td>
                            <td><t t-esc="line.description or line.product_id.name"/></td>
                            <td style="text-align: center;"><t t-esc="line.quantity"/></td>
                            <td><t t-esc="line.serial_number or ''"/></td>
                        </tr>
                    </t>
                </tbody>
            </table>

            <div t-if="o.intro_html"><t t-out="o.intro_html"/></div>
            <div t-if="o.body_html" style="margin-top: 12px;"><t t-out="o.body_html"/></div>
            <div t-if="o.warranty_terms" style="margin-top: 12px;">
                <b>Términos de la garantía:</b>
                <div style="margin-top: 4px;"><t t-out="o.warranty_terms"/></div>
            </div>
            <div t-if="o.closing_html" style="margin-top: 16px;"><t t-out="o.closing_html"/></div>

            <table style="margin-top: 48px;">
                <tr>
                    <td style="width: 50%; text-align: center;">
                        <div>
                            <t t-if="o.client_signature">
                                <img class="sin-signature-img" t-att-src="'data:image/png;base64,' + o.client_signature"/>
                            </t>
                            <t t-else="">
                                <div class="sin-signature-line"></div>
                            </t>
                        </div>
                        <div style="margin-top: 4px; font-weight: bold;">
                            <t t-esc="o.client_signature_name or o.partner_id.name or ''"/>
                        </div>
                        <div style="font-size: 11px; color: #555;">Firma del Cliente</div>
                        <div t-if="o.client_signature_date" style="font-size: 10px; color: #888;">
                            <t t-esc="o.client_signature_date.strftime('%d/%m/%Y %H:%M')"/>
                        </div>
                    </td>
                    <td style="width: 50%; text-align: center;">
                        <div class="sin-signature-line"></div>
                        <div style="margin-top: 4px; font-weight: bold;">
                            <t t-esc="o.company_id.sin_contract_representative or o.company_id.name or ''"/>
                        </div>
                        <div style="font-size: 11px; color: #555;">La Empresa</div>
                    </td>
                </tr>
            </table>
        </div>
    </template>
</odoo>
