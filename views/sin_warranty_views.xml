<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sin_warranty_tree" model="ir.ui.view">
        <field name="name">sin.warranty.tree</field>
        <field name="model">sin.warranty</field>
        <field name="arch" type="xml">
            <list string="Certificados de Garantía">
                <field name="name"/>
                <field name="date"/>
                <field name="date_expiry"/>
                <field name="partner_id"/>
                <field name="state" widget="badge" decoration-success="state == 'signed'"
                       decoration-info="state in ('generated','sent')"
                       decoration-muted="state in ('draft','cancelled')"/>
                <field name="template_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_sin_warranty_form" model="ir.ui.view">
        <field name="name">sin.warranty.form</field>
        <field name="model">sin.warranty</field>
        <field name="arch" type="xml">
            <form string="Certificado de Garantía">
                <header>
                    <button name="action_generate_document" type="object"
                            string="Generar documento"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_open_report" type="object"
                            string="Imprimir PDF"
                            class="btn-primary"
                            invisible="state in ('draft','cancelled')"/>
                    <button name="action_draft" type="object"
                            string="Volver a borrador"
                            invisible="state not in ('generated','sent','cancelled')"/>
                    <button name="action_cancel" type="object"
                            string="Cancelar"
                            invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,generated,sent,signed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="document_title" placeholder="Título del certificado"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="date_expiry" readonly="1"/>
                            <field name="company_id"/>
                            <field name="partner_id" options="{'no_create_edit': True}"/>
                            <field name="partner_document"/>
                        </group>
                        <group>
                            <field name="template_id"/>
                            <field name="sale_order_id"/>
                            <field name="pos_order_id"/>
                            <field name="require_signature"/>
                            <field name="note"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Documento">
                            <div style="border:1px solid #dee2e6; padding:16px; font-size:13px;">
                                <h2 style="text-align:center;"><field name="document_title"/></h2>
                                <hr/>
                                <field name="intro_html" readonly="1"/>
                                <field name="body_html" readonly="1"/>
                                <field name="warranty_terms" readonly="1"/>
                                <field name="closing_html" readonly="1"/>
                            </div>
                        </page>

                        <page string="Productos">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="description"/>
                                    <field name="serial_number"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                </list>
                            </field>
                        </page>

                        <page string="Equipo Técnico" name="equipment_technical">
                            <group>
                                <group>
                                    <field name="equipment_brand"/>
                                    <field name="equipment_model"/>
                                    <field name="equipment_serial"/>
                                </group>
                                <group>
                                    <field name="equipment_processor"/>
                                    <field name="equipment_ram"/>
                                    <field name="equipment_storage"/>
                                </group>
                            </group>
                            <group>
                                <group>
                                    <field name="equipment_os_version"/>
                                    <field name="equipment_omv_version"/>
                                </group>
                                <group>
                                    <field name="equipment_odoo_edition"/>
                                </group>
                            </group>
                        </page>

                        <page string="Firma" name="signature"
                              invisible="not require_signature or state not in ('generated','sent','signed')">
                            <group string="Firma del cliente">
                                <field name="client_signature" widget="sin_signature"
                                       readonly="state in ('draft','signed','cancelled')"/>
                                <field name="client_signature_name"/>
                                <field name="client_signature_date"/>
                                <button name="action_sign_client" type="object"
                                        string="Registrar firma del cliente"
                                        class="btn-primary"
                                        invisible="state != 'sent'"
                                        confirm="¿Confirmar la firma del cliente?"/>
                            </group>
                        </page>

                        <page string="PDF">
                            <group>
                                <field name="document_pdf_name"/>
                                <field name="document_pdf" filename="document_pdf_name" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_sin_warranty" model="ir.actions.act_window">
        <field name="name">Certificados de Garantía</field>
        <field name="res_model">sin.warranty</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
