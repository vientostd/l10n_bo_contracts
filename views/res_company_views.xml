<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_company_contracts_form" model="ir.ui.view">
        <field name="name">res.company.contracts.form</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Contratos y Garantías" name="contracts">
                    <group string="Representación">
                        <group>
                            <field name="sin_contract_representative"
                                   placeholder="Nombre del representante legal"/>
                        </group>
                    </group>
                    <group string="Plantillas por defecto">
                        <group>
                            <field name="default_contract_template_id"/>
                            <field name="auto_generate_contracts"/>
                        </group>
                        <group>
                            <field name="default_warranty_template_id"/>
                            <field name="auto_generate_warranties"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
