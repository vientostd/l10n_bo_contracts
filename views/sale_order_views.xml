<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_contracts_form" model="ir.ui.view">
        <field name="name">sale.order.contracts.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Contratos y Garantías" name="sin_contracts">
                    <group string="Contratos">
                        <field name="sin_contract_ids">
                            <list>
                                <field name="name"/>
                                <field name="state" widget="badge"/>
                                <field name="date"/>
                                <field name="partner_id"/>
                            </list>
                        </field>
                    </group>
                    <group string="Certificados de Garantía">
                        <field name="sin_warranty_ids">
                            <list>
                                <field name="name"/>
                                <field name="state" widget="badge"/>
                                <field name="date_expiry"/>
                                <field name="partner_id"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
