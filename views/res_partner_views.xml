<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_partner_contracts_form" model="ir.ui.view">
        <field name="name">res.partner.contracts.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales_purchases']" position="inside">
                <group string="Firma / Contratos">
                    <field name="sin_signature"
                           widget="image"
                           options="{'preview_image': 'sin_signature', 'accepted_file_extensions': ['png']}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
